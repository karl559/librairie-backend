# /etc/systemd/system/libris.service : démarre le site au démarrage du serveur et le relance en cas de plantage
[Unit]
Description=Libris - librairie numerique
After=network.target postgresql.service

[Service]
User=libris
WorkingDirectory=/home/libris/librairie-backend
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
