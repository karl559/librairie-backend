# À copier en .env sur le serveur : cp deploy/env.production.example .env  puis nano .env
PORT=3000
BASE_URL=https://votre-domaine.com
DATABASE_URL=postgres://libris:MOT_DE_PASSE_BASE@localhost:5432/libris

# Générez chaque secret avec : openssl rand -hex 32
ADMIN_KEY=
PAYMENT_SECRET=

# E-mails : un service d'envoi professionnel (Brevo, Mailjet...) est préférable à Gmail pour de vrais clients
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Libris <livres@votre-domaine.com>"
SHOP_NAME=Libris
MAIL_REPLY_TO=aide@votre-domaine.com

# Paiement SingPay
PAYMENT_PROVIDER=singpay
SINGPAY_CLIENT_ID=
SINGPAY_CLIENT_SECRET=
SINGPAY_WALLET=
# 0 en ligne : avec 1, un paiement de test (débité puis remboursé) livrerait des livres gratuitement !
SINGPAY_TEST_MODE=0

# 0 = ventes fermées (message "bientôt"). Passez à 1 seulement quand SingPay a activé votre portefeuille (goLive) et que tout est testé.
SALES_OPEN=0

# Pages légales (/p/mentions-legales, /p/conditions-de-vente...) : renseignez TOUT avant d'ouvrir les ventes.
# Les informations manquantes s'affichent en jaune « À COMPLÉTER » sur les pages.
LEGAL_NAME=
LEGAL_STATUS=
LEGAL_ID=
ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
HOST_INFO=
REFUND_DAYS=
REFUND_DELAY=
RETENTION=
LAW_AND_COURT=
