PORT=3000
BASE_URL=https://votre-domaine.com
DATABASE_URL=postgres://libris:motdepasse@localhost:5432/libris

# E-mail (SMTP) : Brevo, Mailjet, Gmail avec mot de passe d'application...
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Libris <livres@votre-domaine.com>"

# Paiement : "mock" (simulé, sans argent) ou "singpay"
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=changez-moi-longue-chaine-aleatoire

# Clé pour renvoyer un e-mail depuis l'admin
ADMIN_KEY=changez-moi-aussi

# Délai (secondes) de relance automatique des e-mails non partis (facultatif)
#RETRY_SECONDS=300

# SingPay : identifiants de ton espace client.singpay.ga (portefeuille de test d'abord)
SINGPAY_CLIENT_ID=
SINGPAY_CLIENT_SECRET=
SINGPAY_WALLET=
#SINGPAY_DISBURSEMENT=
# 1 = portefeuille de test SingPay (paiement débité puis remboursé : accepté comme réussi). 0 en production !
SINGPAY_TEST_MODE=1

# Réglages avancés SingPay (facultatifs) : délai d'attente d'une réponse (ms) et minutes avant de conclure qu'une demande n'est jamais arrivée
# Paiement réussi en production : transaction.status = Terminate ET transaction.result = Success (valeurs indiquées par SingPay)
#SINGPAY_SUCCESS_STATUS=Terminate
#SINGPAY_SUCCESS_RESULT=Success
#SINGPAY_TIMEOUT_MS=20000
#SINGPAY_NOTFOUND_MINUTES=3

# Nom de la boutique dans les e-mails, et adresse où les clients peuvent répondre (facultatif mais recommandé)
SHOP_NAME=Libris
#MAIL_REPLY_TO=aide@votre-domaine.com
# Gmail (pour démarrer sans nom de domaine) : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=adresse gmail,
#   SMTP_PASS=mot de passe d'application (16 lettres), MAIL_FROM="Libris <la-meme-adresse@gmail.com>"
# Test : node scripts/email-test.js votre@adresse.com

# Pages légales (/p/mentions-legales, /p/conditions-de-vente...) : renseignez TOUT avant d'ouvrir les ventes.
# Les informations manquantes s'affichent en jaune « À COMPLÉTER » sur les pages.
LEGAL_NAME=
LEGAL_STATUS=
LEGAL_ID=
ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
HOST_INFO=
REFUND_DAYS=
REFUND_DELAY=
RETENTION=
LAW_AND_COURT=

# --- Hébergement en ligne (Supabase) : voir VALIDATION-SUPABASE.md ---
#STORAGE=supabase
#SUPABASE_URL=https://IDENTIFIANT.supabase.co
#SUPABASE_SERVICE_KEY=
#DATABASE_SSL=1
# Envoi d'e-mails par API web (obligatoire sur Render gratuit, où le SMTP est bloqué) :
#BREVO_API_KEY=
#RESEND_API_KEY=
